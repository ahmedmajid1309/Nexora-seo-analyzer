# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/services/render-worker/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/services/render-worker/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# test artifacts
/test-results/
/playwright-report/

# visual evidence (screenshots, recordings)
/visual-evidence/

# OS files
Thumbs.db
Desktop.ini

# editor caches
.vscode/
.idea/
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts

# Python cache
__pycache__/
*.pyc

# temporary root files (logs, audit scripts, output)
*.log
/audit-screenshots/
/visual-evidence.zip
.audit-*
format-check.txt
lint-output.txt
typecheck-output.txt
test-output*.txt
dev-server*.log
