# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

# External API Keys (optional — development works without them)
PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=

# AI Executive Summaries (optional — disabled by default)
AI_SUMMARY_ENABLED=false
AI_SUMMARY_PROVIDER_ORDER=gemini,groq
AI_SUMMARY_TIMEOUT_MS=12000
AI_SUMMARY_MAX_INPUT_CHARS=24000
AI_SUMMARY_MAX_OUTPUT_TOKENS=1200
AI_SUMMARY_CACHE_TTL_MS=900000
AI_SUMMARY_CACHE_MAX_ENTRIES=100
AI_SUMMARY_PROVIDER_MAX_ATTEMPTS=1

# Rendered DOM Worker (optional — disabled by default)
RENDER_WORKER_ENABLED=false
RENDER_WORKER_URL=http://localhost:3001
RENDER_WORKER_SECRET=
RENDER_WORKER_TIMEOUT_MS=8000

# Deployment (optional — defaults work for local dev)
NODE_ENV=development
