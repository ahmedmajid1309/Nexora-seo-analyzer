# Site Configuration
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_VERSION=1.0.0

# External API Keys (optional — development works without them)
PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=

# AI Executive Summaries (optional — disabled by default)
AI_SUMMARY_ENABLED=false
AI_SUMMARY_PROVIDER_ORDER=gemini,groq
AI_SUMMARY_TIMEOUT_MS=12000
AI_SUMMARY_MAX_INPUT_CHARS=24000
AI_SUMMARY_MAX_OUTPUT_TOKENS=1200
AI_SUMMARY_CACHE_TTL_MS=900000
AI_SUMMARY_CACHE_MAX_ENTRIES=100
AI_SUMMARY_PROVIDER_MAX_ATTEMPTS=1

# Report Storage and Optional Accounts (optional — disabled by default)
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=false
REPORT_STORAGE_ENABLED=false
REPORT_ANONYMOUS_RETENTION_DAYS=7
REPORT_AUTHENTICATED_RETENTION_DAYS=90
REPORT_DELETION_GRACE_DAYS=7
INTERNAL_CLEANUP_SECRET=

# Distributed Jobs, Redis Cache, and Object Storage (optional — disabled by default)
REDIS_URL=
AUDIT_QUEUE_ENABLED=false
AUDIT_WORKER_CONCURRENCY=1
AUDIT_JOB_TIMEOUT_MS=120000
AUDIT_CACHE_TTL_MS=300000
OBJECT_STORAGE_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_SIGNED_URL_TTL_SECONDS=300

# Rendered DOM Worker (optional — disabled by default)
RENDER_WORKER_ENABLED=false
RENDER_WORKER_URL=
RENDER_WORKER_SECRET=
RENDER_WORKER_TIMEOUT_MS=8000

# Deployment (optional — defaults work for local dev)
NODE_ENV=development
