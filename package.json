{
  "name": "nexora-seo-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render-worker": "vitest run --config services/render-worker/vitest.config.ts",
    "test:db": "vitest run src/lib/db src/lib/reports",
    "test:audit-worker": "vitest run --config services/audit-worker/vitest.config.ts",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:cleanup-expired": "node scripts/db-cleanup-expired.mjs",
    "db:studio": "drizzle-kit studio",
    "worker:audit": "tsx services/audit-worker/src/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
